# Configuração Agent Corp

agent:
  name: "Kaixa Jr"
  version: "1.0.0"

repository:
  owner: "Kaixadagua"
  name: "kaixa-jr"
  base_branch: "dev"

backpressure:
  threshold: 50

cron:
  improvement: 5min
  worker: 10min
  guardian: 5min

limits:
  agents: 2
  tokens: 360000

auto_merge: true

environment:
  node_env: "production"
  log_level: "info"
  max_memory_mb: 512
