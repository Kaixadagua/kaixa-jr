{
  "name": "kaixa-jr",
  "version": "1.0.0",
  "description": "Autonomous AI Agent for Continuous Software Improvement",
  "main": "src/core/agent.js",
  "bin": {
    "kaixa": "./bin/kaixa.js"
  },
  "scripts": {
    "start": "node src/core/agent.js",
    "health": "node scripts/health/kaixa-guardian.js",
    "report": "node scripts/reports/kaixa-report-35min.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"bin/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "validate": "node -e \"const c=require('./src/core/config').getConfig();process.exit(c.validate().valid?0:1)\"",
    "docker:build": "docker build -t kaixa-jr:latest .",
    "docker:run": "docker run -d --name kaixa-jr -v $(pwd)/memory:/app/memory kaixa-jr:latest",
    "docker:compose": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "sync": "node scripts/sync/git-sync.js",
    "deploy": "./scripts/deploy.sh"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "continuous-improvement",
    "automation"
  ],
  "author": "Kaixa Jr <kaixa@example.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaixadagua/kaixa-jr.git"
  },
  "bugs": {
    "url": "https://github.com/kaixadagua/kaixa-jr/issues"
  },
  "homepage": "https://github.com/kaixadagua/kaixa-jr#readme"
}
